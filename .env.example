# -----------------------------------------------------------------------------
# LabMaster AI — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development (never commit `.env`).
# On Vercel, set these in: Project → Settings → Environment Variables.

# GEMINI_API_KEY (required for live AI):
#   Get a key at https://aistudio.google.com/app/apikey
#   Without a real key, the app runs in "simulation mode" — every AI endpoint
#   falls back to built-in offline responses and preset clinical cases.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NODE_ENV:
#   Not needed on Vercel (managed automatically).
#   Only relevant if you run the standalone server (`npm run build && npm start`),
#   where NODE_ENV=production makes server.ts serve the built dist/ folder.
# NODE_ENV="production"
