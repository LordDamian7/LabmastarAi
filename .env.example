# -----------------------------------------------------------------------------
# LabMaster AI — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development (never commit `.env`).
# On Vercel, set these in: Project → Settings → Environment Variables.

# GEMINI_API_KEY (required for live AI):
#   Get a key at https://aistudio.google.com/app/apikey
#   Without a real key, the app runs in "simulation mode" — every AI endpoint
#   falls back to built-in offline responses and preset clinical cases.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE (required): auth, database and file storage.
#   Both values are public (they ship to the browser); data is protected by
#   row-level security, not by keeping these secret. The API server reuses them.
#   Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL="https://exolnlhzrjbichqzsqss.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_NxYLufsC1xpNudW0i_sxqA_B3YBduCH"

# AI_HOURLY_LIMIT / AI_DAILY_LIMIT (optional):
#   Per-user caps on AI calls (chat, case generation, grading). Defaults: 40 / 150.
# AI_HOURLY_LIMIT="40"
# AI_DAILY_LIMIT="150"

# NODE_ENV:
#   Not needed on Vercel (managed automatically).
#   Only relevant if you run the standalone server (`npm run build && npm start`),
#   where NODE_ENV=production makes server.ts serve the built dist/ folder.
# NODE_ENV="production"
